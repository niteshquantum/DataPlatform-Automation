pipeline {

    agent none

    stages {

        stage('Load Configuration') {
            steps {
                script {

                    // Read configuration
                    def config = load "jenkins/pipeline_config.groovy"

                    // Phase-1 (Hardcoded)
                    def database = "MYSQL"
                    def action   = "SETUP"

                    // Get configuration
                    def dbConfig = config[database]

                    if (dbConfig == null) {
                        error("Database configuration not found : ${database}")
                    }

                    def nodeLabel   = dbConfig.node
                    def pipelineFile = dbConfig.actions[action]

                    echo "========================================="
                    echo "Database : ${database}"
                    echo "Action   : ${action}"
                    echo "Node     : ${nodeLabel}"
                    echo "Pipeline : ${pipelineFile}"
                    echo "========================================="

                    // Load selected pipeline
                    def pipelineScript = load(pipelineFile)

                    // Execute
                    pipelineScript.run(nodeLabel)

                }
            }
        }
    }
}