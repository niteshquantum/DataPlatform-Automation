pipeline {

    agent none

    options {
        disableConcurrentBuilds()
        timestamps()
    }

    parameters {

        choice(
            name: 'DATABASE',
            choices: [
                'MYSQL',
                'POSTGRESQL',
                'MSSQL',
                'MONGODB'
            ],
            description: 'Select Database'
        )

        choice(
            name: 'ACTION',
            choices: [
                'SETUP',
                'LOAD',
                'CLEANUP'
            ],
            description: 'Select Action'
        )

    }

    stages {

        stage('Route Pipeline') {

            steps {

                script {

                    switch (params.DATABASE) {

                        case 'MYSQL':

                            switch (params.ACTION) {

                                case 'SETUP':
                                    mysqlSetup()
                                    break

                                case 'LOAD':
                                    mysqlLoad()
                                    break

                                case 'CLEANUP':
                                    mysqlCleanup()
                                    break

                                default:
                                    error "Unsupported Action"

                            }

                            break

                        case 'POSTGRESQL':

                            switch (params.ACTION) {

                                case 'SETUP':
                                    postgresSetup()
                                    break

                                case 'LOAD':
                                    postgresLoad()
                                    break

                                case 'CLEANUP':
                                    postgresCleanup()
                                    break

                                default:
                                    error "Unsupported Action"

                            }

                            break

                        case 'MSSQL'

                            switch (params.ACTION) {

                                case 'SETUP':
                                    mssqlSetup()
                                    break

                                case 'LOAD':
                                    mssqlLoad()
                                    break

                                case 'CLEANUP':
                                    mssqlCleanup()
                                    break

                                default:
                                    error "Unsupported Action"

                            }

                            break

                        case 'MONGODB'

                            switch (params.ACTION) {

                                case 'SETUP':
                                    mongoSetup()
                                    break

                                case 'LOAD':
                                    mongoLoad()
                                    break

                                case 'CLEANUP':
                                    mongoCleanup()
                                    break

                                default:
                                    error "Unsupported Action"

                            }

                            break

                        default:

                            error "Unsupported Database"

                    }

                }

            }

        }

    }

}